# ============================================================
# SolarCalc LK V1.0 — AI Technical Assistant Environment Configuration
# ============================================================

# --- Local Open-Source LLM Provider (Ollama) ---
# Set the base URL for your local or network Ollama instance (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Primary Ollama chat model (e.g., mistral, llama3, qwen2.5:7b)
OLLAMA_MODEL=mistral

# Embedding model for Ollama (optional; if unset, pure-Python semantic embedder is used)
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Cloud LLM Providers (Fallbacks / Alternates) ---
# Google Gemini API Key (Gemini 1.5 Flash / 2.0 Flash)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI-compatible API Key (OpenAI, Groq, OpenRouter, DeepSeek)
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- RAG Vector Database Configuration ---
# Path to persistent vector database directory
VECTOR_DB_PATH=data/vector_db

# Top K chunks retrieved for context injection
RAG_TOP_K=5

# Minimum cosine similarity threshold for document chunks (0.0 to 1.0)
RAG_SIMILARITY_THRESHOLD=0.15

# --- External Search Provider ---
# Enable or disable live external DuckDuckGo search queries
ENABLE_WEB_SEARCH=true
